#!/bin/bash

# Setup script for tmux-resurrect plugin
# This script installs TPM (Tmux Plugin Manager) and configures tmux-resurrect

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log() {
    echo -e "${GREEN}[setup-tmux-resurrect]${NC} $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

warn() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

# Check if tmux is installed
check_tmux() {
    if ! command -v tmux >/dev/null 2>&1; then
        error "tmux is not installed. Please install tmux first."
        exit 1
    fi
    
    log "tmux is installed: $(tmux -V)"
}

# Install TPM (Tmux Plugin Manager)
install_tpm() {
    local tpm_dir="$HOME/.tmux/plugins/tpm"
    
    if [ -d "$tpm_dir" ]; then
        log "TPM is already installed at $tpm_dir"
        return
    fi
    
    log "Installing TPM (Tmux Plugin Manager)..."
    git clone https://github.com/tmux-plugins/tpm "$tpm_dir"
    
    if [ $? -eq 0 ]; then
        log "TPM installed successfully"
    else
        error "Failed to install TPM"
        exit 1
    fi
}

# Create tmux resurrect directory
create_resurrect_dir() {
    local resurrect_dir="$HOME/.tmux/resurrect"
    
    if [ ! -d "$resurrect_dir" ]; then
        log "Creating tmux resurrect directory: $resurrect_dir"
        mkdir -p "$resurrect_dir"
    else
        log "tmux resurrect directory already exists: $resurrect_dir"
    fi
}

# Show usage instructions
show_usage() {
    cat << EOF

${GREEN}tmux-resurrect Setup Complete!${NC}

${BLUE}Usage:${NC}
1. Start tmux: tmux
2. Install plugins: Press Ctrl-a + I (capital i)
3. Save session: Press Ctrl-a + Ctrl-s
4. Restore session: Press Ctrl-a + Ctrl-r

${BLUE}Key Bindings:${NC}
- Ctrl-a + Ctrl-s: Save tmux environment
- Ctrl-a + Ctrl-r: Restore tmux environment

${BLUE}Features:${NC}
- Saves all sessions, windows, panes and their order
- Restores current working directory for each pane
- Restores exact pane layouts within windows
- Saves and restores vim/neovim sessions
- Saves and restores pane contents
- Automatically saves every 15 minutes

${BLUE}Configuration:${NC}
- Session files are stored in: ~/.tmux/resurrect/
- Vim sessions are automatically saved/restored
- Pane contents are captured and restored
- Additional programs (ssh, mysql, psql, vim, nvim) are restored

${BLUE}Next Steps:${NC}
1. Start tmux: tmux
2. Install plugins: Press Ctrl-a + I
3. Test the plugin by creating some windows/panes
4. Save with Ctrl-a + Ctrl-s
5. Kill tmux and restart: tmux
6. Restore with Ctrl-a + Ctrl-r

${YELLOW}Note:${NC} The first time you press Ctrl-a + I, it may take a moment to download the plugins.

EOF
}

# Main setup function
main() {
    log "Setting up tmux-resurrect plugin..."
    
    check_tmux
    install_tpm
    create_resurrect_dir
    
    log "Setup completed successfully!"
    show_usage
}

# Run main function
main "$@" 